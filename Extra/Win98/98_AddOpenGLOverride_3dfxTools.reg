REGEDIT4

;Force OpenGL rendering depth to 16bit or 32bit, for 3dfx Tools in glide section

;Glide variable holder with default value "0"
[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\Display\0000\GLIDE]
"FX_GL_FORCE_16BPP_PIX" = "0"
"FX_GL_FORCE_16BPP_TEXTURES" = "0"

;Folder with all entries
[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\Display\0000\GLIDE\OpenGL Color Depth]
@ = ""
"Control" = "Combo"
"Default" = "0"
"List" = "Default - Use desktop,Force 16bit,Force 32bit"
"Tweak Map" = "*,1,2"
"Tweak Value" = "FX_GL_FORCE_16BPP_PIX"
"Help" = "Forces 16/32bit rendering - This will only affect OpenGl games. With MesaFx only Force 16bit changes anything, its default is 32bit"
"Value" = "0"

;Folder with all entries
[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\Display\0000\GLIDE\OpenGL Textures Depth]
@ = ""
"Control" = "Combo"
"Default" = "0"
"List" = "Default - Use desktop,Force 16bit,Force 32bit"
"Tweak Map" = "*,1,2"
"Tweak Value" = "FX_GL_FORCE_16BPP_TEXTURES"
"Help" = "Forces 16/32bit textures - This will only affect OpenGl games. With MesaFx only Force 16bit changes anything, its default is 32bit"
"Value" = "0"

;;For IniFile - Override rendering depth 16/32bit
;HKR,Glide\"OpenGL Color Depth",Control,,"Combo"
;HKR,Glide\"OpenGL Color Depth",List,,"Default - Use desktop,Force 16bit,Force 32bit"
;HKR,Glide\"OpenGL Color Depth",Value,,"0"
;HKR,Glide\"OpenGL Color Depth",Default,,"0"
;HKR,Glide\"OpenGL Color Depth","Tweak Value",,"FX_GL_FORCE_16BPP_PIX"
;HKR,Glide\"OpenGL Color Depth","Tweak Map",,"*,1,2"
;HKR,Glide\"OpenGL Color Depth","Help",,"Forces 16/32bit rendering - This will only affect OpenGl games. With MesaFx only Force 16bit changes anything, its default is 32bit"
;HKR,Glide,FX_GL_FORCE_16BPP_PIX,,"0"

;;For IniFile - Override textures depth 16/32bit
;HKR,Glide\"OpenGL Textures Depth",Control,,"Combo"
;HKR,Glide\"OpenGL Textures Depth",List,,"Default - Use desktop,Force 16bit,Force 32bit"
;HKR,Glide\"OpenGL Textures Depth",Value,,"0"
;HKR,Glide\"OpenGL Textures Depth",Default,,"0"
;HKR,Glide\"OpenGL Textures Depth","Tweak Value",,"FX_GL_FORCE_16BPP_TEXTURES"
;HKR,Glide\"OpenGL Textures Depth","Tweak Map",,"*,1,2"
;HKR,Glide\"OpenGL Textures Depth","Help",,"Forces 16/32bit textures - This will only affect OpenGl games. With MesaFx only Force 16bit changes anything, its default is 32bit"
