;=== TEST: native panel mode, 30Hz ===
; 3440x1440 at 30Hz -- the panel's own resolution rather than a 600-line
; mode.  Registry only for now: Glide has no 3440x1440 in _resTable, so
; this is a Windows desktop mode to prove the timing syncs before any
; driver tables are touched.
;
; CVT-RB, same recipe as the rest: H blank 160 (48/32/80), V front 3,
; V sync 10, flags 8.  43.83 kHz / 157.79 MHz -- modest for the RAMDAC.
; 30Hz is the unknown: many panels refuse it outright.
;3440x1440
;Modes
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\MODES\8\3440,1440]
@ = "30"

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\MODES\16\3440,1440]
@ = ""

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\MODES\32\3440,1440]
@ = ""
;Timings
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\TIMINGS\3440,1440]

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\TIMINGS\3440,1440\30Hz]
@ = "3600,3488,3520,1461,1443,1453,8,157790000,3000,8,33760"
"Supported" = "BPP+8+16+32,DDRAW"

