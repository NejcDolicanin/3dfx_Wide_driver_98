REGEDIT4

;Force OpenGL rendering depth to 16bit or 32bit, for 3dfx Tools in glide section

;Glide variable holder with default value "0"
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\GLIDE]
"FX_GL_FORCE_16BPP_PIX" = "0"
"FX_GL_FORCE_16BPP_TEXTURES" = "0"

;Folder with all entries
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\GLIDE\OpenGL Force rendering depth 16/32bit]
@ = ""
"Control" = "Combo"
"Default" = "0"
"List" = "Default - Use desktop,Force 16bit,Force 32bit"
"Tweak Map" = "*,1,2"
"Tweak Value" = "FX_GL_FORCE_16BPP_PIX"
"Help" = "Forces 16/32bit rendering - This will only affect OpenGl games"
"Value" = "0"

;Folder with all entries
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\3dfxvs\Device0\GLIDE\OpenGL Force textures depth 16/32bit]
@ = ""
"Control" = "Combo"
"Default" = "0"
"List" = "Default - Use desktop,Force 16bit,Force 32bit"
"Tweak Map" = "*,1,2"
"Tweak Value" = "FX_GL_FORCE_16BPP_TEXTURES"
"Help" = "Forces 16/32bit textures - This will only affect OpenGl games"
"Value" = "0"

;;For IniFile - Override rendering depth 16/32bit
;HKR,Glide\"OpenGL Force rendering depth 16/32bit",Control,,"Combo"
;HKR,Glide\"OpenGL Force rendering depth 16/32bit",List,,"Default - Use desktop,Force 16bit,Force 32bit"
;HKR,Glide\"OpenGL Force rendering depth 16/32bit",Value,,"0"
;HKR,Glide\"OpenGL Force rendering depth 16/32bit",Default,,"0"
;HKR,Glide\"OpenGL Force rendering depth 16/32bit","Tweak Value",,"FX_GL_FORCE_16BPP_PIX"
;HKR,Glide\"OpenGL Force rendering depth 16/32bit","Tweak Map",,"*,1,2"
;HKR,Glide\"OpenGL Force rendering depth 16/32bit","Help",,"Forces 16/32bit rendering - This will only affect OpenGl games"
;HKR,Glide,FX_GL_FORCE_16BPP_PIX,,"0"

;;For IniFile - Override textures depth 16/32bit
;HKR,Glide\"OpenGL Force textures depth 16/32bit",Control,,"Combo"
;HKR,Glide\"OpenGL Force textures depth 16/32bit",List,,"Default - Use desktop,Force 16bit,Force 32bit"
;HKR,Glide\"OpenGL Force textures depth 16/32bit",Value,,"0"
;HKR,Glide\"OpenGL Force textures depth 16/32bit",Default,,"0"
;HKR,Glide\"OpenGL Force textures depth 16/32bit","Tweak Value",,"FX_GL_FORCE_16BPP_TEXTURES"
;HKR,Glide\"OpenGL Force textures depth 16/32bit","Tweak Map",,"*,1,2"
;HKR,Glide\"OpenGL Force textures depth 16/32bit","Help",,"Forces 16/32bit textures - This will only affect OpenGl games"
